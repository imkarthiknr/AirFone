# Copy to api/.env for local development. Every value can also be an environment variable.
DATABASE_URL=sqlite:///./airfone.db
# DATABASE_URL=mysql+pymysql://airfone:airfone@localhost:3306/airfone

# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me

# First admin account (created by `python -m app.seed` when none exists)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-too

WEB_BASE_URL=http://localhost:4200
CORS_ORIGINS=["http://localhost:4200"]

# Optional real e-mail delivery (otherwise messages go to the outbox only)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=AirFone <no-reply@airfone.example>
